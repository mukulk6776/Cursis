// Cursis — Startup Operations Platform
// Prisma Schema v1.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  projects Project[]
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String
  avatarUrl           String?
  role                String   @default("member") // "owner" | "admin" | "member"
  title               String?
  weeklyCapacityHours Int      @default(40)
  // NOTE: currentWorkload is NOT stored here.
  // It is dynamically calculated by summing estimatedHours
  // of all assigned tasks where status != DONE.
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  assignedTasks Task[]    @relation("TaskAssignee")
  comments      Comment[]
  filesUploaded File[]

  @@index([organizationId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("ACTIVE") // "PLANNING" | "ACTIVE" | "ON_HOLD" | "COMPLETED" | "ARCHIVED"
  priority    String   @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  startDate   DateTime @default(now())
  endDate     DateTime?
  color       String   @default("#6366f1") // UI accent color for the project
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([organizationId])
}

model Task {
  id             String    @id @default(cuid())
  title          String
  description    String?
  status         String    @default("TODO") // "TODO" | "IN_PROGRESS" | "REVIEW" | "DONE"
  priority       String    @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  estimatedHours Float     @default(0)
  dueDate        DateTime?
  completedAt    DateTime?
  order          Int       @default(0) // For ordering within a column
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments Comment[]
  files    File[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
}

model File {
  id        String   @id @default(cuid())
  name      String
  url       String
  size      Int      @default(0) // in bytes
  mimeType  String   @default("application/octet-stream")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
}
