# ==============================================================================
# Cursis Enterprise Operating System — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development or configure these variables
# in your enterprise cloud runtime (Vercel, AWS ECS, GCP Cloud Run, Kubernetes).
#
# SECURITY NOTICE: Never commit real credentials, API secrets, or private keys to
# source control. All secrets should be securely managed via a KMS or secret manager.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SESSION & EDGE SECURITY (CRITICAL)
# ------------------------------------------------------------------------------
# Cryptographic secret used for signing and validating secure HTTP-only cookies
# in proxy.ts edge middleware. Must be at least 32 characters long.
AUTH_SESSION_SECRET=your_super_secure_random_secret_at_least_32_chars_long

# ------------------------------------------------------------------------------
# 3. ENTERPRISE PERSISTENCE LAYER (MONGODB ATLAS)
# ------------------------------------------------------------------------------
# Primary cluster connection string for workspace data, ORDIS audit logs, and CRM
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cursis?retryWrites=true&w=majority
MONGODB_DB_NAME=cursis

# ------------------------------------------------------------------------------
# 4. FIREBASE CLIENT CONFIGURATION (AUTH & STORAGE)
# ------------------------------------------------------------------------------
# Public credentials for Firebase Authentication client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 5. FIREBASE ADMIN SDK (SERVER-SIDE TOKEN VERIFICATION & RBAC)
# ------------------------------------------------------------------------------
# Service account credentials for server-side token minting & user governance
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 6. ORDIS AI MULTI-MODEL INTELLIGENCE ENGINE
# ------------------------------------------------------------------------------
# Groq Cloud API Key (LLaMA 3.3 70B Versatile for zero-latency deterministic execution)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Gemini 2.5 Flash for deep multimodal analysis & paperwork)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL COMMUNICATIONS & NOTIFICATIONS
# ------------------------------------------------------------------------------
# Resend API Key for workspace invitations, meeting agendas, and legal paperwork alerts
RESEND_API_KEY=your_resend_api_key_here